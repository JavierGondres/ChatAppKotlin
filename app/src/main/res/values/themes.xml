<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ChatApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/chatapp_primary</item>
        <item name="colorOnPrimary">@color/chatapp_on_primary</item>
        <item name="colorPrimaryContainer">@color/chatapp_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/chatapp_on_primary_container</item>
        <item name="colorSecondary">@color/chatapp_secondary</item>
